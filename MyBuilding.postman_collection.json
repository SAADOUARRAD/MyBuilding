                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cout\": 750.00\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/work-orders/1/close",
              "host": ["{{baseUrl}}"],
              "path": ["api", "work-orders", "1", "close"]
            }
          }
        }
