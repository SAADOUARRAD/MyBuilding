{
  "info": {
    "name": "MyBuilding - Microservices API Collection",
    "description": "Collection complète et scénarisée pour la validation des opérations CRUD autonomes des services MyBuilding via l'API Gateway (Port 8080).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Service Residents",
      "item": [
        {
          "name": "1.1 - Récupérer tous les résidents",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/residents",
              "host": ["{{baseUrl}}"],
              "path": ["api", "residents"]
            }
          }
        },
        {
          "name": "1.2 - Récupérer un résident par ID (1)",
          "request": {
            "method": "GET",
            "header": [],
