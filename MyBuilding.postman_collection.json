            "url": {
              "raw": "{{baseUrl}}/api/work-orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "work-orders"]
            }
          }
        },
        {
          "name": "2.5 - Clôturer un WorkOrder (Statut: CLOTURE + résout le ticket)",
          "request": {
            "method": "PATCH",
            "header": [
